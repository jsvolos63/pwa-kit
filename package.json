{
  "name": "@jfs/pwa-kit",
  "version": "0.7.0",
  "description": "Shared, dependency-free service-worker primitives (versioned app-shell caching; cache-first / network-first / stale-while-revalidate / network-first-with-timeout strategies; multi-cache eviction) plus the page-side registerServiceWorker helper, extracted from the JFS family of buildless static PWAs.",
  "type": "module",
  "license": "MIT",
  "author": "jsvolos63",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsvolos63/pwa-kit.git"
  },
  "homepage": "https://github.com/jsvolos63/pwa-kit#readme",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js"
  },
  "bin": {
    "jfs-pwa-kit-vendor": "bin/vendor.mjs"
  },
  "files": [
    "index.js",
    "bin"
  ],
  "scripts": {
    "test": "node --test test.mjs test-vendor.mjs",
    "lint": "eslint .",
    "kit-pins:bump": "jfs-bump-kit-pins"
  },
  "dependencies": {
    "@jfs/vendor-cli": "github:jsvolos63/vendor-cli#276274b63dea9e88d36e70f7e77bc49e6e97e96b"
  },
  "keywords": [
    "service-worker",
    "pwa",
    "offline",
    "app-shell",
    "cache"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0"
  }
}
